<%= simple_form_for [ :admin, category ], html: { class: "space-y-4 rounded-lg border border-gray-200 bg-white p-6 shadow-sm" } do |f| %>
  <%= f.error_notification %>
  <%= f.input :name, input_html: { class: "w-full rounded border border-gray-300 px-3 py-2" } %>
  <%= f.button :submit, submit_label, class: "cursor-pointer rounded bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-500" %>
<% end %>
