<% content_for :title, t(".title") %>

<div class="mb-4 flex items-center justify-between">
  <h1 class="text-3xl font-bold"><%= t(".title") %></h1>
  <%= link_to t(".add"), new_admin_category_path, class: "rounded bg-emerald-600 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-500" %>
</div>

<%= render "web/admin/shared/nav" %>

<div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
  <table class="w-full text-left text-sm">
    <thead class="bg-gray-100 text-gray-600">
      <tr>
        <th class="px-4 py-3"><%= Category.human_attribute_name(:name) %></th>
        <th class="px-4 py-3"><%= t(".actions") %></th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr class="border-t border-gray-200">
          <td class="px-4 py-3"><%= category.name %></td>
          <td class="px-4 py-3">
            <div class="flex items-center gap-3">
              <%= link_to t(".edit"), edit_admin_category_path(category), class: "text-emerald-700 hover:underline" %>
              <%= button_to t(".destroy"), admin_category_path(category), method: :delete, form: { data: { turbo_confirm: t("web.confirm") } }, class: "cursor-pointer text-red-700 hover:underline" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-6"><%= paginate @categories %></div>
