<%= simple_form_for bulletin, html: { class: "space-y-4 rounded-lg border border-gray-200 bg-white p-6 shadow-sm" } do |f| %>
  <%= f.error_notification %>
  <%= f.input :title, input_html: { class: "w-full rounded border border-gray-300 px-3 py-2" } %>
  <%= f.input :description, as: :text, input_html: { rows: 6, class: "w-full rounded border border-gray-300 px-3 py-2" } %>
  <%= f.association :category, collection: Category.order(:name), input_html: { class: "w-full rounded border border-gray-300 px-3 py-2" } %>
  <%= f.input :image, as: :file, input_html: { accept: "image/png,image/jpeg,image/gif,image/webp" } %>
  <%= f.button :submit, submit_label, class: "cursor-pointer rounded bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-500" %>
<% end %>
