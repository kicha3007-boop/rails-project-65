<%= search_form_for q, url: url, class: "mb-6 flex flex-wrap items-end gap-3 rounded-lg border border-gray-200 bg-white p-4" do |f| %>
  <div>
    <%= f.label :title_cont, t("web.search.title"), class: "mb-1 block text-sm font-medium" %>
    <%= f.search_field :title_cont, class: "rounded border border-gray-300 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :category_id_eq, t("web.search.category"), class: "mb-1 block text-sm font-medium" %>
    <%= f.collection_select :category_id_eq, categories, :id, :name, { include_blank: true }, class: "rounded border border-gray-300 px-3 py-2" %>
  </div>
  <% if with_state %>
    <div>
      <%= f.label :state_eq, t("web.search.state"), class: "mb-1 block text-sm font-medium" %>
      <%= f.select :state_eq, Bulletin.aasm.states.map { |state| [ state.human_name, state.name ] }, { include_blank: true }, class: "rounded border border-gray-300 px-3 py-2" %>
    </div>
  <% end %>
  <%= f.submit t("web.search.submit"), class: "cursor-pointer rounded bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-500" %>
  <%= link_to t("web.search.reset"), url, class: "px-2 py-2 text-sm text-gray-600 hover:text-emerald-600" %>
<% end %>
