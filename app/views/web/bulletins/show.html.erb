<% content_for :title, @bulletin.title %>

<article class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
  <% if @bulletin.image.attached? %>
    <%= image_tag url_for(@bulletin.image), alt: @bulletin.title, class: "max-h-96 w-full object-cover" %>
  <% end %>
  <div class="p-6">
    <h1 class="mb-2 text-3xl font-bold"><%= @bulletin.title %></h1>
    <div class="mb-4 flex gap-4 text-sm text-gray-500">
      <span><%= @bulletin.category.name %></span>
      <span><%= @bulletin.user.name %></span>
      <span><%= l(@bulletin.created_at, format: :short) %></span>
    </div>
    <div class="text-gray-800"><%= simple_format(@bulletin.description) %></div>
  </div>
</article>
